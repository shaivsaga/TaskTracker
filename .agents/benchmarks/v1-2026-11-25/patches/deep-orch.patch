+test('computePublishDiff detects scheduleChanged, counts it in total, and describeDiff summarizes it', () => {
+  const baseBoard = {
+    tasks: [{ id: 't1', title: 'Essay', subject: 'CP104', dueDate: '2026-11-10', notes: '' }],
+    announcements: [],
+    subjects: [{ code: 'CP104', name: 'CP104', color: '#58affc', active: true }],
+  };
+  const scheduleA = {
+    term: '2ND TERM',
+    sectionLabel: 'DSCT11-A',
+    slots: [{ day: 1, start: '07:30', end: '08:30', kind: 'subject', subject: 'CP104' }],
+  };
+  const scheduleASameDifferentKeyOrder = {
+    slots: [{ subject: 'CP104', kind: 'subject', end: '08:30', start: '07:30', day: 1 }],
+    sectionLabel: 'DSCT11-A',
+    term: '2ND TERM',
+  };
+  const scheduleB = {
+    term: '2ND TERM',
+    sectionLabel: 'DSCT11-A',
+    slots: [{ day: 1, start: '07:30', end: '09:30', kind: 'subject', subject: 'CP104' }],
+  };
+
+  const none = computePublishDiff(baseBoard, baseBoard);
+  assert.equal(none.scheduleChanged, false);
+  assert.equal(none.total, 0);
+
+  const sameOrder = computePublishDiff({ ...baseBoard, schedule: scheduleA }, { ...baseBoard, schedule: scheduleASameDifferentKeyOrder });
+  assert.equal(sameOrder.scheduleChanged, false);
+  assert.equal(sameOrder.total, 0);
+
+  const added = computePublishDiff(baseBoard, { ...baseBoard, schedule: scheduleA });
+  assert.equal(added.scheduleChanged, true);
+  assert.equal(added.total, 1);
+
+  const modified = computePublishDiff({ ...baseBoard, schedule: scheduleA }, { ...baseBoard, schedule: scheduleB });
+  assert.equal(modified.scheduleChanged, true);
+  assert.equal(modified.total, 1);
+
+  const removed = computePublishDiff({ ...baseBoard, schedule: scheduleA }, baseBoard);
+  assert.equal(removed.scheduleChanged, true);
+  assert.equal(removed.total, 1);
+
+  const cleared = computePublishDiff({ ...baseBoard, schedule: scheduleA }, { ...baseBoard, schedule: scheduleB }, { clearBoard: true });
+  assert.equal(cleared.scheduleChanged, false);
+
+  assert.equal(describeDiff({ scheduleChanged: true }), 'schedule changed');
+  assert.equal(describeDiff({ added: 2, scheduleChanged: true }), '2 added, schedule changed');
+  assert.equal(describeDiff({ scheduleChanged: false }), 'No changes');
+});
