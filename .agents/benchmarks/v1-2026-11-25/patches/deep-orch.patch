@@ -149,6 +149,128 @@ function tt_subject_retired($code) {
     return ['code' => (string)$code, 'name' => (string)$code, 'color' => '#c3c7d6', 'active' => false];
 }
 
+// ---- schedule --------------------------------------------------------------------------------
+const TT_SCHEDULE_MAX_SLOTS = 80;
+const TT_SCHEDULE_TIME = '/^([01]\d|2[0-3]):([0-5]\d)$/D';
+
+// Validate an optional class schedule. Returns [normalized|null, null] or [null, error].
+// Absent/null is valid and backward-compatible; any malformed field rejects the whole schedule.
+function tt_schedule_validate($raw, $subjects) {
+    if ($raw === null) return [null, null];
+    if (!is_array($raw) || ($raw !== [] && array_is_list($raw))) return [null, 'schedule must be an object.'];
+    if (!array_key_exists('slots', $raw) || !is_array($raw['slots']) || ($raw['slots'] !== [] && !array_is_list($raw['slots']))) {
+        return [null, 'schedule.slots must be a list.'];
+    }
+    if (count($raw['slots']) > TT_SCHEDULE_MAX_SLOTS) {
+        return [null, 'Too many schedule slots (max ' . TT_SCHEDULE_MAX_SLOTS . ').'];
+    }
+
+    $out = [];
+    foreach (['term', 'sectionLabel', 'adviser', 'room'] as $field) {
+        if (!array_key_exists($field, $raw) || $raw[$field] === null) continue;
+        $val = $raw[$field];
+        if (!is_string($val) || !mb_check_encoding($val, 'UTF-8')) return [null, "schedule.$field must be a string."];
+        if (preg_match('/[\x00-\x1f\x7f]/', $val)) return [null, "schedule.$field has control characters."];
+        $val = trim($val);
+        if (mb_strlen($val) > 80) return [null, "schedule.$field must be at most 80 characters."];
+        if ($val !== '') $out[$field] = $val;
+    }
+
+    $knownSubjects = [];
+    foreach (is_array($subjects) ? $subjects : [] as $s) {
+        if (is_array($s) && is_string($s['code'] ?? null)) $knownSubjects[$s['code']] = true;
+    }
+
+    $byDay = [];
+    $slots = [];
+    foreach ($raw['slots'] as $i => $slot) {
+        $n = $i + 1;
+        if (!is_array($slot) || ($slot !== [] && array_is_list($slot))) {
+            return [null, "Schedule slot $n is not an object."];
+        }
+        $day = $slot['day'] ?? null;
+        if (!is_int($day) || $day < 1 || $day > 5) {
+            return [null, "Schedule slot $n needs a day from 1 (Mon) to 5 (Fri)."];
+        }
+        $start = $slot['start'] ?? null;
+        $end = $slot['end'] ?? null;
+        if (!is_string($start) || !preg_match(TT_SCHEDULE_TIME, $start, $ms)) {
+            return [null, "Schedule slot $n needs a valid 24-hour start time (HH:MM)."];
+        }
+        if (!is_string($end) || !preg_match(TT_SCHEDULE_TIME, $end, $me)) {
+            return [null, "Schedule slot $n needs a valid 24-hour end time (HH:MM)."];
+        }
+        $startMin = ((int)$ms[1]) * 60 + (int)$ms[2];
+        $endMin = ((int)$me[1]) * 60 + (int)$me[2];
+        if ($startMin >= $endMin) {
+            return [null, "Schedule slot $n end time must be after start time."];
+        }
+        foreach ($byDay[$day] ?? [] as $existing) {
+            if ($startMin < $existing[1] && $existing[0] < $endMin) {
+                return [null, "Schedule slot $n overlaps another slot on day $day."];
+            }
+        }
+        $byDay[$day][] = [$startMin, $endMin];
+
+        $hasKind = array_key_exists('kind', $slot) && $slot['kind'] !== null;
+        if ($hasKind) {
+            $kind = $slot['kind'];
+            if (!is_string($kind) || !in_array($kind, ['subject', 'break', 'activity'], true)) {
+                return [null, "Schedule slot $n has an invalid kind."];
+            }
+        } elseif (array_key_exists('subject', $slot) && $slot['subject'] !== null && $slot['subject'] !== '') {
+            $kind = 'subject';
+        } else {
+            return [null, "Schedule slot $n needs a kind or subject."];
+        }
+
+        $entry = [
+            'day'   => $day,
+            'start' => $start,
+            'end'   => $end,
+            'kind'  => $kind,
+        ];
+
+        if ($kind === 'subject') {
+            $subj = $slot['subject'] ?? null;
+            if (!is_string($subj) || $subj === '') {
+                return [null, "Schedule slot $n needs a subject."];
+            }
+            if (!isset($knownSubjects[$subj])) {
+                return [null, "Schedule slot $n uses subject \"$subj\", which is not in the catalog."];
+            }
+            $entry['subject'] = $subj;
+        } else {
+            $label = $slot['label'] ?? null;
+            if (!is_string($label) || !mb_check_encoding($label, 'UTF-8') || preg_match('/[\x00-\x1f\x7f]/', $label)) {
+                return [null, "Schedule slot $n needs a valid label."];
+            }
+            $label = trim($label);
+            if ($label === '' || mb_strlen($label) > 40) {
+                return [null, "Schedule slot $n needs a label of 1-40 characters."];
+            }
+            $entry['label'] = $label;
+        }
+
+        if (array_key_exists('teacher', $slot) && $slot['teacher'] !== null) {
+            $teacher = $slot['teacher'];
+            if (!is_string($teacher) || !mb_check_encoding($teacher, 'UTF-8') || preg_match('/[\x00-\x1f\x7f]/', $teacher)) {
+                return [null, "Schedule slot $n has an invalid teacher."];
+            }
+            $teacher = trim($teacher);
+            if (mb_strlen($teacher) > 80) {
+                return [null, "Schedule slot $n teacher must be at most 80 characters."];
+            }
+            if ($teacher !== '') $entry['teacher'] = $teacher;
+        }
+
+        $slots[] = $entry;
+    }
+
+    $out['slots'] = $slots;
+    return [$out, null];
+}
+
 // ---- identifiers -----------------------------------------------------------------------------
 const TT_SAFE_ID = '/^[\w.\-]{1,64}$/D';
 
