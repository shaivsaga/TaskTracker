+    state.liveBoard = prevLive;
+    state.draftSchedule = prevDraft;
+    state.publishedTasks = prevTasks;
+    state.publishedAnnouncements = prevAnns;
+    state.announcements = prevDraftAnns;
+    state.draftSubjects = prevSubs;
+  }
 });
