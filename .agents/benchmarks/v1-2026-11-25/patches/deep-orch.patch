+test('diffDraft detects draftSchedule vs liveBoard.schedule and counts it in total', () => {
+  const prevLive = state.liveBoard;
+  const prevDraft = state.draftSchedule;
+  const prevTasks = state.publishedTasks;
+  const prevAnns = state.publishedAnnouncements;
+  const prevDraftAnns = state.announcements;
+  const prevSubs = state.draftSubjects;
+  try {
+    state.publishedTasks = [];
+    state.publishedAnnouncements = [];
+    state.announcements = [];
+    state.draftSubjects = [];
+    const schedA = { term: 'T2', slots: [{ day: 1, start: '07:30', end: '08:30', kind: 'subject', subject: 'CP104' }] };
+    const schedB = { term: 'T2', slots: [{ day: 1, start: '08:30', end: '09:30', kind: 'subject', subject: 'CP104' }] };
+
+    state.liveBoard = { tasks: [], announcements: [], subjects: [] };
+    state.draftSchedule = undefined;
+    assert.equal(diffDraft().scheduleChanged, false);
+    assert.equal(diffDraft().total, 0);
+    assert.equal('schedule' in snapshot(), false);
+
+    // Legacy draft (undefined draftSchedule) against a live schedule must NOT report a false deletion or emit schedule.
+    state.liveBoard = { tasks: [], announcements: [], subjects: [], schedule: schedA };
+    state.draftSchedule = undefined;
+    assert.equal(diffDraft().scheduleChanged, false);
+    assert.equal(diffDraft().total, 0);
+    assert.equal('schedule' in snapshot(), false);
+
+    // Explicit null draftSchedule against a live schedule reports scheduleChanged:true and emits schedule:null.
+    state.draftSchedule = null;
+    const clearedLive = diffDraft();
+    assert.equal(clearedLive.scheduleChanged, true);
+    assert.equal(clearedLive.total, 1);
+    assert.equal(describeDiff(clearedLive), 'schedule changed');
+    assert.equal(snapshot().schedule, null);
+
+    state.liveBoard = { tasks: [], announcements: [], subjects: [] };
+    state.draftSchedule = null;
+    assert.equal(diffDraft().scheduleChanged, false);
+    assert.equal(diffDraft().total, 0);
+
+    state.draftSchedule = schedA;
+    const added = diffDraft();
+    assert.equal(added.scheduleChanged, true);
+    assert.equal(added.total, 1);
+    assert.equal(describeDiff(added), 'schedule changed');
+    assert.deepEqual(snapshot().schedule, schedA);
+
+    state.liveBoard = { tasks: [], announcements: [], subjects: [], schedule: schedA };
+    assert.equal(diffDraft().scheduleChanged, false);
+    assert.equal(diffDraft().total, 0);
+
+    state.draftSchedule = schedB;
+    assert.equal(diffDraft().scheduleChanged, true);
+    assert.equal(diffDraft().total, 1);
