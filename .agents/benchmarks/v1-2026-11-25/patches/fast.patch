 .dp-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
+.dp-row { display: contents; }
+.dp-cell { display: flex; }
 .dp-dow { text-align: center; color: var(--mu); font-size: 12px; line-height: 24px; }
