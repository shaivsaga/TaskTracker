+.dp-day { width: 100%; min-height: 44px; background: transparent; color: var(--tx); font-size: 12px; cursor: pointer; }
 .dp-day:hover { background: var(--sf2); }
 .dp-day.is-outside { background: none; color: var(--mu); opacity: 1; }
 .dp-day.is-today { box-shadow: inset 0 0 0 2px var(--ac); }
